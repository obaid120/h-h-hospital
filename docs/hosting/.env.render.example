# Reference values for Render dashboard Environment; do not upload this as .env.
APP_NAME="H&H Hospital"
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://YOUR-SERVICE.onrender.com
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/secrets/aiven-ca.pem
TRUSTED_PROXIES=*
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stderr
LOG_LEVEL=warning
MAIL_MAILER=log
HOSPITAL_TIMEZONE=Asia/Karachi
HOSPITAL_CURRENCY=PKR
INITIAL_ADMIN_NAME="Hospital Administrator"
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
